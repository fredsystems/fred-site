{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "config:best-practices", "default:pinDigestsDisabled"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0 1 * *"]
  },
  "timezone": "Etc/UTC",
  "schedule": ["* 0 1 * *"],
  "enabledManagers": ["nix", "github-actions", "dockerfile", "npm"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "prCreation": "immediate",
  "automerge": true,
  "platformAutomerge": true,
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions", "nix"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "automerge": true
    },
    {
      "groupName": "react ecosystem",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-router",
        "@types/react",
        "@types/react-dom",
        "@vitejs/plugin-react"
      ]
    },
    {
      "groupName": "playwright",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@playwright/test", "@axe-core/playwright"]
    },
    {
      "groupName": "vitest",
      "matchManagers": ["npm"],
      "matchPackageNames": ["vitest", "@vitest/coverage-v8"]
    }
  ]
}
